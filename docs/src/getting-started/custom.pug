extends ../_layout/_docs-layout.pug

block variables
  - var slug = 'custom'
  - var parent = 'getting-started'
  - var title = 'Custom - Getting started - Spectre.css CSS Framework'
  - var description = 'Customize and build Spectre.css with standards-based CSS and the modern PostCSS toolchain.'

block docs-content
  +docs-heading('custom', 'Custom version')
    include ../_layout/_ad-g.pug

    p
      | Spectre uses standards-based CSS source files. Edit the files in
      code /src
      |  directly; Sass and Less are not required.

    +docs-subheading('compiling', 'Building CSS')
    p Install a current Node.js release and run the following commands from the repository root:
    pre.code(data-lang='Bash')
      code
        :highlight(lang="Bash")
          npm install
          npm run build
    p
      | PostCSS and Autoprefixer produce the readable stylesheets, while cssnano creates the
      code .min.css
      |  variants in
      code /dist
      | .
    p Available scripts:
    ul
      li
        code npm run build
        |  — build distribution CSS and documentation
      li
        code npm run build:css
        |  — build distribution CSS only
      li
        code npm run build:docs
        |  — build the documentation site and CSS
      li
        code npm run dev
        |  — watch CSS and Pug files and rebuild on changes
      li
        code npm test
        |  — build and verify all expected artifacts

    +docs-subheading('customizing', 'Customizing CSS')
    p
      | Keep project-specific overrides separate from Spectre so upgrades remain straightforward. Import Spectre first, then define overrides in your own stylesheet.
    pre.code(data-lang='CSS')
      code
        :highlight(lang="css")
          @import "spectre.css/dist/spectre.css";

          :root {
            --project-primary: #2e5bec;
          }

          .btn.btn-primary {
            background: var(--project-primary);
            border-color: var(--project-primary);
          }
    p
      | To ship only selected components, copy the relevant documented rule blocks from
      code src/spectre.css
      |  into a project stylesheet. The source now remains valid CSS at every stage of the build.

    +docs-subheading('folders', 'Folder structure')
    pre.code
      code
        :highlight
          spectre/
          ├── src/                            // Editable CSS sources
          │   ├── spectre.css
          │   ├── spectre-exp.css
          │   └── spectre-icons.css
          ├── dist/                           // Built and minified CSS
          ├── docs/
          │   ├── src/css/                    // Documentation CSS sources
          │   ├── src/**/*.pug                // Documentation templates
          │   └── dist/                       // Built documentation CSS
          ├── scripts/                        // PostCSS/Pug build scripts
          └── package.json

    +docs-subheading('sizes', 'Sizes')
    p
      | The default REM root size is
      code 20px
      | . Component sizes use a 4px-based scale. Override selectors in a project stylesheet when adapting the framework to another design system.

    include ../_layout/_ad-c.pug

  include ../_layout/_footer.pug
